{
  "name": "premium-reel",
  "version": "1.0.0",
  "private": true,
  "description": "\"Your Time Is Running Out\" — 15-second premium vertical Reel built with Remotion",
  "scripts": {
    "dev": "remotion studio",
    "audio": "node scripts/generate-audio.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "still": "remotion still PremiumReel out/preview.png --frame=100",
    "render": "remotion render PremiumReel out/PremiumReel.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@remotion/cli": "4.0.545",
    "@remotion/fonts": "^4.0.545",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.545"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
